  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "baseline-browser-mapping": "^2.9.19",
    "pg": "^8.13.0",
    "supabase": "2.98.2",
    "typescript": "~5.9.2"
  }
}
