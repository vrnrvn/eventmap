{
  "name": "eventmap",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "dev:web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "backend:start": "supabase start -x logflare,vector,imgproxy,edge-runtime",
    "backend:stop": "supabase stop",
    "backend:reset": "supabase db reset --local",
    "backend:env": "node scripts/local-env.mjs",
    "backend:types": "node scripts/generate-db-types.mjs",
    "test:backend": "node scripts/test-local-backend.mjs",
    "typecheck:admin": "tsc --noEmit --project admin/tsconfig.json",
    "audit:submission": "node scripts/audit-submission.mjs",
    "vendor:map": "node scripts/vendor-map.mjs",
    "fix:promotions": "node scripts/run-promotions-fix.js",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "maestro:smoke": "maestro test .maestro/smoke.yaml",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lucide/lab": "^0.1.2",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.21",
    "@teovilla/react-native-web-maps": "^0.9.5",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.7",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.7",
    "leaflet": "1.9.4",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "^1.27.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "zustand": "^5.0.11"
