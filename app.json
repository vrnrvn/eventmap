{
  "expo": {
    "name": "eventmap",
    "slug": "eventmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/EMlogo.png",
    "splash": {
      "image": "./assets/images/EMlogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#083838"
    },
    "scheme": "eventmap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventmap.app",
      "associatedDomains": [
        "applinks:eventmap.pro"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
              "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/dm-sans/400Regular/DMSans_400Regular.ttf",
              "./node_modules/@expo-google-fonts/dm-sans/500Medium/DMSans_500Medium.ttf",
              "./node_modules/@expo-google-fonts/dm-sans/600SemiBold/DMSans_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/dm-sans/700Bold/DMSans_700Bold.ttf"
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.000000000000000000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.eventmap.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "eventmap",
              "host": "auth-callback",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eventmap.pro",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7da7dc4-919f-4d29-981b-777798915b54"
      }
    },
    "owner": "shalommeoded",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a7da7dc4-919f-4d29-981b-777798915b54"
    }
  }
}
