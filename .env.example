# Generated local values: npm run backend:env
EXPO_PUBLIC_BACKEND_MODE=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_MAP_PROVIDER=openstreetmap
# Raster tiles for the default (Leaflet) provider. The built-in default uses
# tile.openstreetmap.org, which is fine locally but NOT permitted for a
# distributed app under the OSM Tile Usage Policy
# (https://operations.osmfoundation.org/policies/tiles/ — distributing an app
# that uses these tiles counts as "heavy use" and gets blocked).
# Before shipping, point these at a provider you are entitled to use — any XYZ
# raster endpoint works (Stadia Maps, Thunderforest, Geoapify, MapTiler, self-hosted).
# EXPO_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png?api_key=YOUR_KEY
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; Provider &copy; OpenStreetMap contributors
# EXPO_PUBLIC_MAP_TILE_MAX_ZOOM=19
EXPO_PUBLIC_ENABLE_PUSH=false
EXPO_PUBLIC_ENABLE_OAUTH=false
# Optional Google provider (requires your own restricted key).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
